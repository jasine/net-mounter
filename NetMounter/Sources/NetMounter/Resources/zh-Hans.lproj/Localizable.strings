/* Saving, operation feedback, and automatic mounting */
"Enter a name for this server." = "请输入服务器名称。";
"Enter a hostname or IP only, without a protocol prefix, slashes, or spaces." = "请输入主机名或 IP，不要包含协议前缀、斜杠或空格。";
"Enter a share or export path." = "请输入共享目录或导出路径。";
"Not mounted" = "未挂载";
