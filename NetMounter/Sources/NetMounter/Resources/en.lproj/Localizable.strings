"Authorize once for automatic NFS mounts…" = "Authorize once for automatic NFS mounts…";
"NFS mounts in ~/NetworkMounts without administrator authorization. The NAS must allow non-reserved source ports." = "NFS mounts in ~/NetworkMounts without administrator authorization. The NAS must allow non-reserved source ports.";
"Could not authorize NFS mounting" = "Could not authorize NFS mounting";
"Could not install the NFS helper. You can still save the server configuration without authorizing." = "Could not install the NFS helper. You can still save the server configuration without authorizing.";
